{
  "schemaVersion": 1,
  "router": {
    "thin": true,
    "ownsAgentRuntime": false,
    "ownsBrowserRuntime": false,
    "ownsEditorRuntime": false,
    "ownsMcpServer": false,
    "workflows": {
      "ui": "whipui",
      "design": "whipdesign"
    }
  },
  "setup": {
    "scope": "project-local",
    "interactiveInstallOnInit": true,
    "nonInteractiveInstall": "use --yes explicitly",
    "neverWritesGlobalConfig": true
  },
  "inputs": [
    "prompt",
    "screenshot",
    "figma",
    "url",
    "existing-repo"
  ],
  "tools": {
    "playwrightMcp": {
      "role": "primary-for-url-and-pick-from-web",
      "required": true
    },
    "chromeDevTools": {
      "role": "optional",
      "required": false
    },
    "figmaMcp": {
      "role": "conditional-on-figma-input",
      "required": false
    }
  },
  "designIntelligence": {
    "preferred": [
      "bundled-sumi-ux-references",
      "impeccable",
      "ui-ux-pro-max",
      "existing-repository-design-system"
    ],
    "roles": {
      "bundled-sumi-ux-references": "task-flows-navigation-and-heuristic-review",
      "impeccable": "scoped-visual-craft-and-critique",
      "ui-ux-pro-max": "optional-task-specific-consultation"
    },
    "discoverAtRuntime": true,
    "installAutomatically": "only-after-explicit-init-confirmation",
    "loading": "one-workflow-owner; specialists loaded per question"
  },
  "visualQa": {
    "maxIterations": 3,
    "viewports": [
      {
        "name": "desktop",
        "width": 1440,
        "height": 900
      },
      {
        "name": "tablet",
        "width": 1024,
        "height": 900
      },
      {
        "name": "mobile",
        "width": 390,
        "height": 844
      }
    ],
    "axes": [
      "identity",
      "product-specificity",
      "concept-coherence",
      "generic-pattern-debt",
      "composition-and-hierarchy",
      "typography",
      "color-and-contrast",
      "spacing-and-density",
      "responsive-behavior",
      "interaction-states",
      "accessibility"
    ]
  },
  "uxQa": {
    "workflow": ".whipui/workflows/ux-review.md",
    "humanEvidenceRequiredForUserTestingClaims": true,
    "outcomes": [
      "observed",
      "blocked",
      "not-tested"
    ]
  }
}
