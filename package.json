{
  "name": "whipui",
  "version": "3.1.0-rc.1",
  "description": "Guided UX/UI Combo: curated product, craft, retrieval and visual iteration through WhipDesign and WhipUI.",
  "type": "module",
  "bin": {
    "whipui": "install/install.mjs"
  },
  "files": [
    "whip-design",
