{
  "name": "whipui",
  "version": "3.0.0",
  "description": "WhipDesign co-design and WhipUI execution: two standalone, intent-preserving UX/UI skills for coding agents.",
  "type": "module",
  "bin": {"whipui": "install/install.mjs"},
